{
  "name": "@sempods/app-ui",
  "version": "0.6.0",
  "description": "UI kit for sempods apps: shadcn/ui components on React Aria, adapters for SDK editors and confirmations, and a theme token contract for Tailwind CSS 4.",
  "keywords": [
    "sempods",
    "react",
    "react-aria",
    "shadcn",
    "tailwindcss",
    "ui"
  ],
  "license": "Apache-2.0",
  "author": "Danilo Stein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sempods/sempods-typescript.git",
    "directory": "packages/app-ui"
  },
  "homepage": "https://github.com/sempods/sempods-typescript/tree/main/packages/app-ui#readme",
  "bugs": {
    "url": "https://github.com/sempods/sempods-typescript/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "styles.css",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.65.0",
    "react-aria-components": "1.22.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "@sempods/app-sdk": "workspace:~",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@sempods/app-sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
