  "cases": [
    {
      "id": "#t0001",
      "name": "Plain literal with URIs",
      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0001-in.jsonld",
      "input": "{\n  \"@id\": \"http://greggkellogg.net/foaf#me\",\n  \"http://xmlns.com/foaf/0.1/name\": \"Gregg Kellogg\"\n}",
      "expect": "<http://greggkellogg.net/foaf#me> <http://xmlns.com/foaf/0.1/name> \"Gregg Kellogg\" .\n"
    },
    {
      "id": "#t0004",
      "name": "Literal with language tag",
      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0004-in.jsonld",
      "input": "{\n  \"http://www.w3.org/2000/01/rdf-schema#label\": {\n    \"@value\": \"A plain literal with a lang tag.\",\n    \"@language\": \"en-us\"\n  }\n}",
      "expect": "_:b0 <http://www.w3.org/2000/01/rdf-schema#label> \"A plain literal with a lang tag.\"@en-us .\n"
    },
    {
      "id": "#t0005",
      "name": "Extended character set literal",
      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0005-in.jsonld",
      "input": "{\n  \"@id\": \"http://greggkellogg.net/foaf#me\",\n  \"http://xmlns.com/foaf/0.1/knows\": {\n    \"http://xmlns.com/foaf/0.1/name\": {\"@value\": \"Herman Iván\", \"@language\": \"hu\"}\n  }\n}\n",
      "expect": "<http://greggkellogg.net/foaf#me> <http://xmlns.com/foaf/0.1/knows> _:b0 .\n_:b0 <http://xmlns.com/foaf/0.1/name> \"Herman Iván\"@hu .\n"
    },
    {
      "id": "#t0006",
      "name": "Typed literal",
      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0006-in.jsonld",
      "input": "{\n  \"@id\":  \"http://greggkellogg.net/foaf#me\",\n  \"http://purl.org/dc/terms/created\":  {\n    \"@value\": \"1957-02-27\",\n    \"@type\": \"http://www.w3.org/2001/XMLSchema#date\"\n  }\n}\n",
      "expect": "<http://greggkellogg.net/foaf#me> <http://purl.org/dc/terms/created> \"1957-02-27\"^^<http://www.w3.org/2001/XMLSchema#date> .\n"
    },
    {
      "id": "#t0007",
      "name": "Tests 'a' generates rdf:type and object is implicit IRI",
      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0007-in.jsonld",
      "input": "{\n  \"@id\": \"http://greggkellogg.net/foaf#me\",\n  \"@type\": \"http://xmlns.com/foaf/0.1/Person\"\n}",
      "expect": "<http://greggkellogg.net/foaf#me> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://xmlns.com/foaf/0.1/Person> .\n"
    },
