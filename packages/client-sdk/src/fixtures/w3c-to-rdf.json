      "kind": "positive",
      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0114-in.jsonld",
      "input": "{\n  \"@id\": \"_:g\",\n  \"@graph\": {\n    \"@id\": \"http://example/s\",\n    \"http://example/p\": {\"@id\": \"http://example/o\"}\n  }\n}",
      "expect": "<http://example/s> <http://example/p> <http://example/o> _:b0 .\n"
