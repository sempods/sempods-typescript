      "base": "https://w3c.github.io/json-ld-api/tests/toRdf/0113-in.jsonld",
      "input": "{\n  \"@id\": \"http://example/g\",\n  \"@graph\": {\n    \"@id\": \"http://example/s\",\n    \"http://example/p\": {\"@id\": \"http://example/o\"}\n  }\n}",
      "expect": "<http://example/s> <http://example/p> <http://example/o> <http://example/g> .\n"
